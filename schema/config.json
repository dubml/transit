{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "adminAddr": {
      "type": "string",
      "default": {
        "Localhost": [
          true,
          26000
        ]
      }
    },
    "healthAddr": {
      "type": "string",
      "default": {
        "SocketAddr": "0.0.0.0:26021"
      }
    },
    "llm": {
      "anyOf": [
        {
          "$ref": "#/$defs/LlmConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "numWorkerThreads": {
      "type": "integer",
      "format": "uint",
      "default": 3,
      "minimum": 0
    },
    "routes": {
      "type": "array",
      "default": [
        {
          "name": "default",
          "port": 6000
        }
      ],
      "items": {
        "$ref": "#/$defs/RouteConfig"
      }
    },
    "storage": {
      "$ref": "#/$defs/StorageConfig",
      "default": {
        "mode": "file"
      }
    },
    "terminationMaxDeadline": {
      "type": "string",
      "default": "5s"
    },
    "terminationMinDeadline": {
      "type": "string",
      "default": "0s"
    },
    "xds": {
      "$ref": "#/$defs/XdsConfig",
      "default": {
        "localConfig": null
      }
    }
  },
  "$defs": {
    "AiModelMapping": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "providerRef": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "providerRef"
      ]
    },
    "AiProviderConfig": {
      "type": "object",
      "properties": {
        "apiKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "models": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AiModelMapping"
          }
        },
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "name"
      ]
    },
    "ConfigStoreMode": {
      "type": "string",
      "enum": [
        "file",
        "database",
        "readOnly"
      ]
    },
    "LlmConfig": {
      "type": "object",
      "properties": {
        "ai": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AiProviderConfig"
          }
        },
        "port": {
          "$ref": "#/$defs/LlmPort",
          "default": "default"
        }
      }
    },
    "LlmPort": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      ]
    },
    "RouteConfig": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "default": "default"
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "port"
      ]
    },
    "StorageConfig": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/ConfigStoreMode",
          "default": "file"
        }
      }
    },
    "XdsConfig": {
      "type": "object",
      "properties": {
        "localConfig": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    }
  }
}