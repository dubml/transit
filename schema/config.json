{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeConfig",
  "type": "object",
  "properties": {
    "ports": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/PortConfig"
      }
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "HeaderMatch": {
      "type": "object",
      "properties": {
        "exact": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "present": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "ListenerConfig": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/ListenerProtocol",
          "default": "http"
        },
        "routes": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RouteConfig"
          }
        }
      },
      "required": [
        "name"
      ]
    },
    "ListenerProtocol": {
      "type": "string",
      "enum": [
        "http",
        "https",
        "tcp",
        "tls",
        "grpc"
      ]
    },
    "PathMatch": {
      "type": "object",
      "properties": {
        "exact": {
          "type": [
            "string",
            "null"
          ]
        },
        "prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "regex": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "PortConfig": {
      "type": "object",
      "properties": {
        "defaultPort": {
          "type": "integer",
          "format": "uint16",
          "default": 6010,
          "maximum": 65535,
          "minimum": 0
        },
        "listeners": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ListenerConfig"
          }
        }
      }
    },
    "RouteConfig": {
      "type": "object",
      "properties": {
        "endpoints": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "matches": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RouteMatch"
          }
        },
        "name": {
          "type": "string"
        },
        "policies": {
          "type": "array",
          "default": [],
          "items": true
        }
      },
      "required": [
        "name"
      ]
    },
    "RouteMatch": {
      "type": "object",
      "properties": {
        "headers": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/HeaderMatch"
          }
        },
        "methods": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/PathMatch"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}