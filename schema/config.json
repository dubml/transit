{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeConfig",
  "type": "object",
  "properties": {
    "llm": {
      "anyOf": [
        {
          "$ref": "#/$defs/LlmConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "mcp": {
      "anyOf": [
        {
          "$ref": "#/$defs/McpConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "routes": {
      "anyOf": [
        {
          "$ref": "#/$defs/RoutesConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "ui": {
      "anyOf": [
        {
          "$ref": "#/$defs/UiConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "A2aConfig": {
      "type": "object",
      "properties": {
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "HeaderMatch": {
      "type": "object",
      "properties": {
        "exact": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "present": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "ListenerProtocol": {
      "type": "string",
      "enum": [
        "http",
        "https",
        "tcp",
        "tls",
        "grpc"
      ]
    },
    "LlmConfig": {
      "type": "object",
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LlmModelItem"
          }
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "default": 6020,
          "maximum": 65535,
          "minimum": 0
        },
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LlmProviderConfig"
          }
        },
        "subscriptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LlmSubscriptionConfig"
          }
        }
      }
    },
    "LlmModelItem": {
      "anyOf": [
        {
          "$ref": "#/$defs/LlmSubscriptionConfig"
        },
        {
          "$ref": "#/$defs/LlmProviderConfig"
        }
      ]
    },
    "LlmProviderConfig": {
      "type": "object",
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LlmProviderModel"
          }
        },
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "name"
      ]
    },
    "LlmProviderModel": {
      "type": "object",
      "properties": {
        "apiKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "LlmSubscriptionConfig": {
      "type": "object",
      "properties": {
        "account": {
          "type": "string"
        },
        "excludedModels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "modelAliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelAliasConfig"
          }
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "id",
        "account"
      ]
    },
    "McpConfig": {
      "type": "object",
      "properties": {
        "failurePolicy": {
          "$ref": "#/$defs/McpFailurePolicy",
          "default": "failClosed"
        },
        "policies": {
          "type": "array",
          "items": true
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "default": 6030,
          "maximum": 65535,
          "minimum": 0
        },
        "prefixPolicy": {
          "$ref": "#/$defs/McpPrefixPolicy",
          "default": "conditional"
        },
        "sessionMode": {
          "$ref": "#/$defs/McpSessionMode",
          "default": "stateful"
        },
        "targets": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/McpTargetConfig"
          }
        }
      }
    },
    "McpFailurePolicy": {
      "type": "string",
      "enum": [
        "failClosed",
        "failOpen"
      ]
    },
    "McpHttpTargetConfig": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        }
      },
      "required": [
        "host"
      ]
    },
    "McpOpenApiSchema": {
      "type": "object",
      "properties": {
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "McpOpenApiTargetConfig": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "schema": {
          "$ref": "#/$defs/McpOpenApiSchema"
        }
      },
      "required": [
        "host",
        "schema"
      ]
    },
    "McpPrefixPolicy": {
      "type": "string",
      "enum": [
        "conditional",
        "always"
      ]
    },
    "McpSessionMode": {
      "type": "string",
      "enum": [
        "stateful",
        "stateless"
      ]
    },
    "McpStdioTargetConfig": {
      "type": "object",
      "properties": {
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clearEnv": {
          "type": "boolean",
          "default": false
        },
        "cmd": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "cmd"
      ]
    },
    "McpTargetConfig": {
      "type": "object",
      "properties": {
        "mcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpHttpTargetConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "openapi": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpOpenApiTargetConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "stdio": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpStdioTargetConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "ModelAliasConfig": {
      "type": "object",
      "properties": {
        "alias": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "alias"
      ]
    },
    "PathMatch": {
      "type": "object",
      "properties": {
        "exact": {
          "type": [
            "string",
            "null"
          ]
        },
        "prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "regex": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "RouteBackend": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            }
          },
          "required": [
            "host"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "RouteListenerConfig": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string",
          "default": "default"
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "default": 6010,
          "maximum": 65535,
          "minimum": 0
        },
        "protocol": {
          "$ref": "#/$defs/ListenerProtocol",
          "default": "http"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RouteTargetConfig"
          }
        },
        "tls": {
          "anyOf": [
            {
              "$ref": "#/$defs/TlsConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RouteMatch": {
      "type": "object",
      "properties": {
        "headers": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/HeaderMatch"
          }
        },
        "methods": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/PathMatch"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RoutePolicies": {
      "type": "object",
      "properties": {
        "a2a": {
          "anyOf": [
            {
              "$ref": "#/$defs/A2aConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "RouteTargetConfig": {
      "type": "object",
      "properties": {
        "a2a": {
          "anyOf": [
            {
              "$ref": "#/$defs/A2aConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "backends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RouteBackend"
          }
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RouteMatch"
          }
        },
        "methods": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string",
          "default": "default-target"
        },
        "policies": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoutePolicies"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RoutesConfig": {
      "type": "object",
      "properties": {
        "listeners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RouteListenerConfig"
          }
        }
      }
    },
    "TlsConfig": {
      "type": "object",
      "properties": {
        "certificate": {
          "type": [
            "string",
            "null"
          ]
        },
        "privateKey": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "UiConfig": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "format": "uint16",
          "default": 6000,
          "maximum": 65535,
          "minimum": 0
        }
      }
    }
  }
}