{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeConfig",
  "type": "object",
  "properties": {
    "llm": {
      "anyOf": [
        {
          "$ref": "#/$defs/LlmConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "mcp": {
      "anyOf": [
        {
          "$ref": "#/$defs/McpConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "ports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PortConfig"
      }
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "A2aConfig": {
      "type": "object",
      "properties": {
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "HeaderMatch": {
      "type": "object",
      "properties": {
        "exact": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "present": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "ListenerConfig": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "default": "default"
        },
        "protocol": {
          "$ref": "#/$defs/ListenerProtocol",
          "default": "http"
        },
        "routes": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RouteConfig"
          }
        }
      }
    },
    "ListenerProtocol": {
      "type": "string",
      "enum": [
        "http",
        "https",
        "tcp",
        "tls",
        "grpc"
      ]
    },
    "LlmConfig": {
      "type": "object",
      "properties": {
        "defaultPort": {
          "type": "integer",
          "format": "uint16",
          "default": 6020,
          "maximum": 65535,
          "minimum": 0
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LlmModelItem"
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LlmProviderConfig"
          }
        }
      }
    },
    "LlmModelItem": {
      "anyOf": [
        {
          "$ref": "#/$defs/LlmModelSubscription"
        },
        {
          "$ref": "#/$defs/LlmProviderConfig"
        }
      ]
    },
    "LlmModelSubscription": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "modelAlias": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelAlias"
          }
        },
        "modelIgnore": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "subscribe": {
          "type": "string"
        }
      },
      "required": [
        "subscribe",
        "id",
        "name"
      ]
    },
    "LlmProviderConfig": {
      "type": "object",
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LlmProviderModel"
          }
        },
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "name"
      ]
    },
    "LlmProviderModel": {
      "type": "object",
      "properties": {
        "apiKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "McpConfig": {
      "type": "object",
      "properties": {
        "defaultPort": {
          "type": "integer",
          "format": "uint16",
          "default": 6030,
          "maximum": 65535,
          "minimum": 0
        },
        "failurePolicy": {
          "$ref": "#/$defs/McpFailurePolicy",
          "default": "failClosed"
        },
        "policies": {
          "type": "array",
          "items": true
        },
        "prefixPolicy": {
          "$ref": "#/$defs/McpPrefixPolicy",
          "default": "conditional"
        },
        "sessionMode": {
          "$ref": "#/$defs/McpSessionMode",
          "default": "stateful"
        },
        "targets": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/McpTarget"
          }
        }
      }
    },
    "McpFailurePolicy": {
      "type": "string",
      "enum": [
        "failClosed",
        "failOpen"
      ]
    },
    "McpHttpTarget": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        }
      },
      "required": [
        "host"
      ]
    },
    "McpOpenApiSchema": {
      "type": "object",
      "properties": {
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "inline": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "McpOpenApiTarget": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "schema": {
          "$ref": "#/$defs/McpOpenApiSchema"
        }
      },
      "required": [
        "host",
        "schema"
      ]
    },
    "McpPrefixPolicy": {
      "type": "string",
      "enum": [
        "conditional",
        "always"
      ]
    },
    "McpSessionMode": {
      "type": "string",
      "enum": [
        "stateful",
        "stateless"
      ]
    },
    "McpStdioTarget": {
      "type": "object",
      "properties": {
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clearEnv": {
          "type": "boolean",
          "default": false
        },
        "cmd": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "cmd"
      ]
    },
    "McpTarget": {
      "type": "object",
      "properties": {
        "mcp": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpHttpTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "openapi": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpOpenApiTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "stdio": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpStdioTarget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "ModelAlias": {
      "type": "object",
      "properties": {
        "cur": {
          "type": "string"
        },
        "src": {
          "type": "string"
        }
      },
      "required": [
        "src",
        "cur"
      ]
    },
    "PathMatch": {
      "type": "object",
      "properties": {
        "exact": {
          "type": [
            "string",
            "null"
          ]
        },
        "prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "regex": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "PortConfig": {
      "type": "object",
      "properties": {
        "defaultPort": {
          "type": "integer",
          "format": "uint16",
          "default": 6010,
          "maximum": 65535,
          "minimum": 0
        },
        "listeners": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ListenerConfig"
          }
        }
      }
    },
    "RouteBackend": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            }
          },
          "required": [
            "host"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "RouteConfig": {
      "type": "object",
      "properties": {
        "a2a": {
          "anyOf": [
            {
              "$ref": "#/$defs/A2aConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "backends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RouteBackend"
          }
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matches": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RouteMatch"
          }
        },
        "name": {
          "type": "string",
          "default": "default-route"
        },
        "policies": {
          "type": "array",
          "items": true
        }
      }
    },
    "RouteMatch": {
      "type": "object",
      "properties": {
        "headers": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/HeaderMatch"
          }
        },
        "methods": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/PathMatch"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}