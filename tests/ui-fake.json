{
  "version": "demo-1",
  "listeners": [
    {
      "name": "public-http",
      "bind": "0.0.0.0:18080",
      "protocol": "http",
      "virtual_hosts": [
        {
          "name": "shop",
          "domains": ["shop.example.com", "*"],
          "routes": [
            {
              "name": "orders",
              "matches": [{ "path": { "type": "prefix", "value": "/orders" } }],
              "weighted_clusters": [
                { "name": "orders", "weight": 80 },
                { "name": "orders-canary", "weight": 20 }
              ]
            },
            {
              "name": "reviews",
              "matches": [{ "path": { "type": "prefix", "value": "/reviews" } }],
              "weighted_clusters": [{ "name": "reviews", "weight": 100 }]
            }
          ]
        }
      ]
    }
  ],
  "clusters": [
    {
      "name": "orders",
      "http2": true,
      "endpoints": [
        { "address": "10.0.1.11", "port": 8080, "healthy": true, "node_name": "node-a" },
        { "address": "10.0.1.12", "port": 8080, "healthy": true, "node_name": "node-b" },
        { "address": "10.0.1.13", "port": 8080, "healthy": false, "node_name": "node-c" }
      ]
    },
    {
      "name": "orders-canary",
      "endpoints": [
        { "address": "10.0.2.21", "port": 8080, "healthy": true, "node_name": "node-a" }
      ]
    },
    {
      "name": "reviews",
      "endpoints": [
        { "address": "10.0.3.31", "port": 8443, "healthy": true, "node_name": "node-b" }
      ],
      "tls": { "mode": "simple", "sni": "reviews.svc.cluster.local" }
    }
  ],
  "providers": [
    {
      "name": "openai",
      "kind": "open-ai",
      "base_url": "https://api.openai.com/v1"
    },
    {
      "name": "anthropic",
      "kind": "anthropic",
      "base_url": "https://api.anthropic.com"
    }
  ],
  "backends": [
    {
      "name": "catalog-api",
      "type": "http",
      "endpoint": "http://catalog.app.svc:8080",
      "policies": ["edge-auth"]
    },
    {
      "name": "vllm-deepseek-r1",
      "type": "llm",
      "account_type": "self-hosted",
      "endpoint": "http://vllm-cluster.ai-infra.svc:8000/v1",
      "max_concurrency": 64,
      "models": ["deepseek-r1", "deepseek-v3"]
    },
    {
      "name": "codex-team-sub",
      "type": "llm",
      "account_type": "subscription",
      "provider": "openai",
      "models": ["gpt-5", "gpt-4o"],
      "quota_state": {
        "observed_at": "2026-09-04T07:00:00Z",
        "status": "active",
        "reset_cards": 2,
        "windows": [
          {
            "name": "primary",
            "window": "5h",
            "used_percent": 42,
            "reset_at": "01:32",
            "reset_after_seconds": 5520,
            "source": "provider"
          },
          {
            "name": "weekly",
            "window": "7d",
            "used_percent": 18,
            "reset_at": "4d 06h",
            "reset_after_seconds": 367200,
            "source": "provider"
          }
        ]
      }
    },
    {
      "name": "openai-official-payg",
      "type": "llm",
      "account_type": "api-key",
      "provider": "openai",
      "models": ["gpt-4o", "gpt-4o-mini"]
    },
    {
      "name": "claude-official",
      "type": "llm",
      "account_type": "api-key",
      "provider": "anthropic",
      "models": ["claude-3-5-sonnet"]
    },
    {
      "name": "github-mcp",
      "type": "mcp",
      "endpoint": "http://mcp-github.tooling.svc:3000",
      "tools": ["search_repos", "create_issue"]
    },
    {
      "name": "planner",
      "type": "a2a",
      "endpoint": "http://planner.agents.svc:8080",
      "agent": "planner-v1"
    }
  ],
  "routes": [
    {
      "name": "chat",
      "protocol": "llm",
      "matches": [{ "path": { "type": "prefix", "value": "/v1" } }],
      "weighted_backends": [
        { "name": "vllm-deepseek-r1", "weight": 50, "priority": 1 },
        { "name": "codex-team-sub", "weight": 30, "priority": 1 },
        { "name": "openai-official-payg", "weight": 20, "priority": 2 }
      ],
      "policies": ["token-budget"]
    },
    {
      "name": "mcp",
      "protocol": "mcp",
      "matches": [{ "path": { "type": "prefix", "value": "/mcp" } }],
      "weighted_backends": [{ "name": "github-mcp", "weight": 100 }]
    },
    {
      "name": "a2a",
      "protocol": "a2a",
      "matches": [{ "path": { "type": "prefix", "value": "/a2a" } }],
      "weighted_backends": [{ "name": "planner", "weight": 100 }]
    }
  ],
  "policies": [
    {
      "name": "edge-auth",
      "action": "allow",
      "auth": { "type": "api-key", "header": "authorization" }
    },
    {
      "name": "token-budget",
      "rate_limit": { "requests": 60, "window_seconds": 60, "key": "route" },
      "token_limit": { "tokens": 100000, "window_seconds": 3600, "key": "route" }
    }
  ]
}
